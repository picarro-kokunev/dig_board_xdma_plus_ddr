`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Testbench for adc_ctrl and adc_ad_ltc22xx
//
// This testbench instantiates the ADC model and the control block, connects
// the DDR ADC outputs to the controller input, and generates a system clock
// and reset.
//////////////////////////////////////////////////////////////////////////////////

module adc_ctrl_tb;
    parameter DATA_W = 14;

    // system signals
    logic clk;
    logic reset_n;

    // ADC chip interface
    logic adc_clk;
    logic [DATA_W-1:0] adc_data_a;
    logic [DATA_W-1:0] adc_data_b;
    logic [1:0][DATA_W-1:0] adc_data;
    logic [1:0] adc_ofa;

    // Controller output
    logic [1:0][DATA_W-1:0] data;

    // Instantiate the ADC model
    adc_ad_ltc22xx #(.DATA_W(DATA_W)) adc_ad_ltc22xx_inst (
        .clk(adc_clk),
        .adc_data_a(adc_data_a),
        .adc_data_b(adc_data_b)
    );

    // Connect ADC model outputs to controller DDR data input
    assign adc_data[0] = adc_data_a;
    assign adc_data[1] = adc_data_b;
    assign adc_ofa = '0;

    // Instantiate the controller under test
    adc_ctrl #(.DATA_W(DATA_W)) adc_ctrl_inst (
        .clk(clk),
        .reset_n(reset_n),
        .adc_clk(adc_clk),
        .adc_data(adc_data),
        .adc_ofa(adc_ofa),
        .data(data)
    );

    // System clock generation
    initial begin
        clk = 0;
        forever #5 clk = ~clk;  // 100 MHz clock
    end

    // set input data and verify the output
    logic [1:0][DATA_W-1:0] adc_data_last = '0;
    initial begin
        integer i;
        // fill the queues
        for( i = 0; i < 1000; i = i + 1)
        begin
            adc_ad_ltc22xx_inst.adc_a.push_back( i );            
            adc_ad_ltc22xx_inst.adc_b.push_back( i + 'h100);            
        end
    end

    // set input data and verify the output    
    integer j = 0;
    always@(posedge clk)
    begin
        if(reset_n)
        begin                
            // check that adc_data is incrementing  
            if( adc_data_last[j] != 0 )
            begin
                if( adc_data_last[j] + 1 != adc_data[j] )
                    $display("%0t : wrong adc_data : expected %h got %h", $time, adc_data_last[j] + 1, adc_data[j] );
            end
            // update  
            adc_data_last = adc_data;  
        end 
    end
    // Reset sequence
    initial begin
	@(posedge clk);
        reset_n = 0;
        #20;
	@(posedge clk);
        reset_n = 1;
    end

    // Waveform dump
    initial begin
        //$dumpfile("adc_ctrl_tb.vcd");
        //$dumpvars(0, adc_ctrl_tb);
    end

    // Monitor outputs
    initial begin
        $display("Time  clk adc_clk data[0]          data[1]");
        $monitor("%0t  %b   %b   %h  %h", $time, clk, adc_clk, data[0], data[1]);
    end

    // Run simulation
    initial 
    begin
        //
        #1000;
        $display("Test complete.");
        $stop;
    end

endmodule
